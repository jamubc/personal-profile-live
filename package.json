{
  "name": "2025-profile-shop",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node --experimental-strip-types --no-warnings scripts/test-scope.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/check-budget.mjs",
    "preview": "node scripts/serve-dist.mjs dist 4173",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.mjs\"",
    "figures": "node scripts/figure-meta.mjs",
    "revisions": "node --experimental-strip-types --no-warnings scripts/revisions.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "images": "node scripts/optimize-images.mjs",
    "stats": "node scripts/fetch-github-stats.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.4.31",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.0.0"
  }
}

/* Tailwind CSS imports */
@import 'tailwindcss';
@import './tokens.css';

/* Font imports */
@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap');

@config "../../tailwind.config.js";
@source "../../index.html" "../**/*.{js,jsx,ts,tsx,html}";

/* Base styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  /* Hide Scrollbar - Cross Browser */
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

/* Hide Scrollbar - WebKit */
*::-webkit-scrollbar {
  display: none;
}

html {
  scroll-padding-top: 100px;
  /* Increased for larger fixed headers */
}

body {
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-family: "Open Sans", Inter, Helvetica, Arial, sans-serif;
  min-height: 100vh;
  /* Text Rendering Optimization */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  /* Removed default padding to allow full-width sections */
  overflow-x: hidden;
}

/* Button Reset */
button {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  cursor: pointer;
  outline: inherit;
}

/* Accessibility */
*:focus-visible {
  outline: 2px solid var(--color-accent-primary);
  outline-offset: 4px;
  border-radius: 2px;
}

/* Custom utilities */
@layer utilities {

  /* Canvas handling */
  canvas {
    background: transparent;
  }

  /* Refined Section Divider */
  .section-divider {
    position: relative;
  }

  .section-divider::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border-secondary), transparent);
  }

  /* Color utilities mapping to variables */
  .bg-bg-primary {
    background-color: var(--color-bg-primary) !important;
  }

  .bg-bg-card {
    background-color: var(--color-bg-card) !important;
  }

  .bg-bg-card-featured {
    background-color: var(--color-bg-card-featured) !important;
  }

  .bg-bg-card-inline {
    background-color: var(--color-bg-card-inline) !important;
  }

  .text-text-primary {
    color: var(--color-text-primary) !important;
  }

  .text-text-secondary {
    color: var(--color-text-secondary) !important;
  }

  .border-border-primary {
    border-color: var(--color-border-primary) !important;
  }

  /* Transitions */
  .transition-smooth {
    transition: all 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* ============================================
     GLASSMORPHISM EFFECT
     Advanced "looking through glass" effect with:
     - backdrop-filter blur for frosted glass
     - translucent backgrounds with rgba
     - subtle borders and edge highlights
     - SVG displacement for realistic distortion
     - proper shadows and lighting
     ============================================ */

  /* Standard glass card */
  .glass-card-standard {
    /* Translucent background */
    background: rgba(15, 18, 25, 0.12);

    /* Frosted glass blur effect */
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);

    /* Glass border with subtle highlight */
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;

    /* Depth shadows and edge highlight */
    box-shadow:
      /* Inner highlight (top glass edge) */
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      /* Soft outer glow */
      0 8px 32px rgba(0, 0, 0, 0.4),
      /* Colored accent glow from background */
      0 4px 16px rgba(64, 80, 255, 0.1);

    /* Optional: SVG displacement for glass distortion */
    filter: url(#glass-distortion);

    /* Smooth transitions */
    transition: all 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  .glass-card-standard:hover {
    /* Enhance on hover */
    background: rgba(15, 18, 25, 0.18);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 12px 48px rgba(0, 0, 0, 0.5),
      0 8px 24px rgba(64, 80, 255, 0.2);
  }

  /* Featured glass card (hero section) */
  .glass-card-featured {
    /* More translucent for prominence */
    background: rgba(20, 24, 35, 0.15);

    /* Stronger blur for featured content */
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);

    /* Brighter border */
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;

    /* Enhanced shadows and highlights */
    box-shadow:
      /* Brighter inner highlight */
      inset 0 2px 0 rgba(255, 255, 255, 0.12),
      inset -1px 0 0 rgba(255, 255, 255, 0.05),
      /* Deeper shadows */
      0 16px 64px rgba(0, 0, 0, 0.5),
      /* Stronger colored glow */
      0 8px 32px rgba(64, 80, 255, 0.15);

    filter: url(#glass-distortion);
    transition: all 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  .glass-card-featured:hover {
    background: rgba(20, 24, 35, 0.22);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.15),
      inset -1px 0 0 rgba(255, 255, 255, 0.08),
      0 20px 80px rgba(0, 0, 0, 0.6),
      0 12px 48px rgba(64, 80, 255, 0.25);
  }

  /* Inline/subtle glass card */
  .glass-card-inline {
    background: rgba(10, 12, 18, 0.08);

    /* Lighter blur for subtle effect */
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);

    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 4px 16px rgba(0, 0, 0, 0.3),
      0 2px 8px rgba(64, 80, 255, 0.05);

    filter: url(#glass-distortion);
    transition: all 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  .glass-card-inline:hover {
    background: rgba(10, 12, 18, 0.12);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 6px 24px rgba(0, 0, 0, 0.35),
      0 3px 12px rgba(64, 80, 255, 0.08);
  }

  /* WebGL-enhanced glass card (combines CSS + shader effects) */
  .glass-card-webgl {
    /* Semi-transparent base - WebGL shader adds the liquid distortion */
    background: rgba(20, 24, 35, 0.25);

    /* Strong backdrop blur for readability */
    backdrop-filter: blur(32px) saturate(200%);
    -webkit-backdrop-filter: blur(32px) saturate(200%);

    /* Prominent border for definition */
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;

    /* Enhanced depth and glow */
    box-shadow:
      /* Bright inner highlight */
      inset 0 2px 0 rgba(255, 255, 255, 0.15),
      inset -1px 0 0 rgba(255, 255, 255, 0.08),
      /* Strong outer depth */
      0 20px 80px rgba(0, 0, 0, 0.6),
      /* Glowing accent from shader background */
      0 10px 40px rgba(64, 80, 255, 0.2),
      /* Additional cyan glow for liquid glass feel */
      0 0 60px rgba(0, 255, 255, 0.1);

    /* Position context for WebGL overlay */
    position: relative;
    overflow: hidden;

    transition: all 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  .glass-card-webgl:hover {
    background: rgba(20, 24, 35, 0.35);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.2),
      inset -1px 0 0 rgba(255, 255, 255, 0.12),
      0 25px 100px rgba(0, 0, 0, 0.7),
      0 15px 60px rgba(64, 80, 255, 0.3),
      0 0 80px rgba(0, 255, 255, 0.15);
  }

  /* Ensures text remains readable over WebGL effect */
  .glass-card-webgl * {
    position: relative;
    z-index: 10;
  }
}
